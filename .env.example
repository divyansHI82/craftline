PORT=3000
NODE_ENV=development
# Optional. Number of Node.js workers on one server (1–8); default is 1.
WEB_CONCURRENCY=1
# Production requires shared PostgreSQL; local development uses SQLite when unset.
# DATABASE_URL=postgresql://user:password@host:5432/craftline
# PostgreSQL connection budget per application host, divided between workers.
# PG_POOL_BUDGET=20
# Enable certificate-verified TLS when required by the database provider.
# PGSSLMODE=require
# Enable only behind a trusted reverse proxy that sets X-Forwarded-For.
# TRUST_PROXY=false
# Optional public deployment URL for the read-only hosted performance benchmark.
# BENCHMARK_BASE_URL=https://your-craftline-site.example
# BENCHMARK_CONCURRENCY=8
# BENCHMARK_ROUNDS=5
ADMIN_EMAIL=moderator@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
# Optional. By default, the SQLite database is stored in ./data/craftline.sqlite
# DATABASE_PATH=C:/data/craftline.sqlite
# Production requires Cloudinary; local development uses database-backed image storage when unset.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
